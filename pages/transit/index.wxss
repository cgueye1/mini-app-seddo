.navigate-stop { display: inline-block; color: #d95c18; background: #fff1e9; border-radius: 18rpx; padding: 8rpx 14rpx; margin-top: 12rpx; font-size: 20rpx; }
.page { min-height: 100vh; background: #f5f7f8; color: #172027; padding-bottom: 48rpx; }
.header { padding: 48rpx 36rpx 28rpx; display: flex; align-items: center; gap: 20rpx; background: #fff; }
.back { width: 56rpx; height: 56rpx; line-height: 48rpx; text-align: center; font-size: 52rpx; color: #d95c18; }
.eyebrow { color: #d95c18; font-size: 20rpx; letter-spacing: 3rpx; font-weight: 700; }
.title { font-size: 46rpx; line-height: 1.2; font-weight: 800; margin-top: 8rpx; }
.search-panel { position: relative; margin: 28rpx 28rpx 18rpx; padding: 24rpx; background: #fff; border-radius: 24rpx; box-shadow: 0 10rpx 30rpx rgba(23,32,39,.08); }
.field-row { height: 82rpx; display: flex; align-items: center; gap: 18rpx; }
.dot { width: 18rpx; height: 18rpx; border-radius: 50%; flex: 0 0 18rpx; }
.origin-dot { background: #16a085; }.destination-dot { background: #d95c18; }
.field-input { flex: 1; height: 72rpx; font-size: 28rpx; border-bottom: 1rpx solid #e6eaec; }
.locate { color: #168f7d; font-size: 42rpx; padding: 8rpx; }.connector { position: absolute; left: 32rpx; top: 82rpx; height: 48rpx; border-left: 2rpx dashed #cdd6d9; }
.swap { position: absolute; right: 34rpx; top: 140rpx; background: #fff2eb; border-radius: 50%; width: 58rpx; height: 58rpx; padding: 14rpx; box-sizing: border-box; }
.suggestions { margin-left: 36rpx; border-top: 1rpx solid #eef1f2; }.suggestion { display: flex; gap: 18rpx; padding: 20rpx 0; border-bottom: 1rpx solid #f0f2f3; }.pin { width: 34rpx; height: 34rpx; flex: 0 0 34rpx; }.suggestion-name { font-size: 26rpx; font-weight: 700; }.suggestion-address { font-size: 21rpx; color: #7b858a; margin-top: 4rpx; max-width: 560rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.tools { display: flex; align-items: center; gap: 12rpx; padding: 0 28rpx; }.tool { background: #fff; padding: 18rpx 14rpx; border-radius: 12rpx; font-size: 22rpx; color: #59666c; }.tool text { margin-left: 6rpx; }.search-button { margin-left: auto; background: #d95c18; color: #fff; border-radius: 12rpx; font-size: 25rpx; padding: 0 28rpx; height: 72rpx; line-height: 72rpx; }
.favorites-title, .results-heading { margin: 34rpx 28rpx 14rpx; font-weight: 800; font-size: 28rpx; }.favorites { margin: 0 28rpx; }.favorite { position: relative; background: #fff; padding: 20rpx 18rpx 20rpx 78rpx; margin-bottom: 10rpx; border-radius: 14rpx; }.favorite-icon { position: absolute; left: 22rpx; top: 26rpx; width: 36rpx; height: 36rpx; }.favorite-label { font-weight: 700; font-size: 25rpx; }.favorite-place { color: #7b858a; font-size: 22rpx; margin-top: 4rpx; }.save-button { position: absolute; right: 14rpx; top: 28rpx; width: 52rpx; height: 44rpx; padding: 0; background: #fff4ed; }.save-button image { width: 28rpx; height: 28rpx; margin-top: 8rpx; }
.state { margin: 28rpx; padding: 28rpx; border-radius: 16rpx; text-align: center; }.loading-state { color: #68757a; background: #fff; }.error-state { background: #fff0ed; color: #b43d24; }.loader { display: inline-block; width: 28rpx; height: 28rpx; margin-right: 12rpx; border: 4rpx solid #f2c7b5; border-top-color: #d95c18; border-radius: 50%; vertical-align: middle; }
.results-heading text { color: #d95c18; margin-left: 8rpx; }.route-card { margin: 0 28rpx 18rpx; padding: 24rpx; background: #fff; border-left: 8rpx solid #d95c18; border-radius: 16rpx; box-shadow: 0 8rpx 24rpx rgba(23,32,39,.06); }.route-top { display: flex; justify-content: space-between; }.route-label { color: #d95c18; font-weight: 800; }.duration { color: #172027; font-weight: 800; }.route-summary { font-size: 34rpx; font-weight: 800; margin: 12rpx 0 22rpx; }.leg { display: flex; gap: 16rpx; padding: 18rpx 0; border-top: 1rpx solid #edf0f1; }.bus-image { width: 86rpx; height: 58rpx; flex: 0 0 86rpx; }.line-badge { min-width: 62rpx; height: 48rpx; line-height: 48rpx; text-align: center; background: #172027; color: #fff; border-radius: 8rpx; font-weight: 800; }.leg-content { flex: 1; }.leg-stops { font-size: 24rpx; font-weight: 700; }.leg-stops text { color: #d95c18; margin: 0 8rpx; }.leg-meta { color: #7b858a; font-size: 21rpx; margin-top: 8rpx; }
.route-tabs { white-space: nowrap; padding: 20rpx 28rpx 12rpx; background: #fff; box-sizing: border-box; }.route-tab { display: inline-flex; vertical-align: top; flex-direction: column; align-items: center; justify-content: center; min-width: 210rpx; height: 98rpx; margin-right: 12rpx; padding: 0 22rpx; box-sizing: border-box; border-radius: 52rpx; background: #f1f2f3; }.route-tab-active { background: #1451aa; color: #fff; box-shadow: 0 8rpx 18rpx rgba(20,81,170,.25); }.tab-title { font-size: 25rpx; font-weight: 800; }.tab-duration { font-size: 21rpx; opacity: .72; margin-top: 6rpx; }
.timeline-route { padding: 26rpx 34rpx 60rpx; background: #fff; }.route-badges { display: flex; gap: 12rpx; margin-bottom: 24rpx; }.direct-badge, .time-badge { border-radius: 28rpx; padding: 10rpx 22rpx; font-size: 23rpx; font-weight: 700; }.direct-badge { border: 2rpx solid #69bd74; color: #378d43; background: #f0fbf1; }.direct-badge.transfer { border-color: #efad62; color: #b86417; background: #fff8ee; }.time-badge { border: 2rpx solid #74b9f5; color: #1474c9; background: #eef8ff; }.timeline-point { position: relative; display: flex; align-items: center; gap: 20rpx; min-height: 58rpx; font-size: 30rpx; font-weight: 800; }.point-ring { width: 30rpx; height: 30rpx; border: 8rpx solid #ed5100; border-radius: 50%; box-sizing: border-box; }.point-pin { color: #f43d4c; font-size: 34rpx; width: 30rpx; text-align: center; }.timeline-leg { margin-left: 14rpx; border-left: 6rpx solid #1859b0; padding-left: 26rpx; }.walk-segment { position: relative; min-height: 92rpx; display: flex; align-items: center; gap: 14rpx; color: #858585; font-size: 23rpx; }.walk-line { position: absolute; left: -30rpx; top: 0; height: 100%; border-left: 4rpx dashed #a7a7a7; }.walk-icon { color: #929292; font-size: 30rpx; }.stop-row { display: flex; align-items: center; gap: 18rpx; min-height: 62rpx; font-size: 25rpx; font-weight: 700; }.stop-row image { width: 42rpx; height: 42rpx; }.bus-card { position: relative; margin: 10rpx 0 12rpx; padding: 24rpx 18rpx 18rpx 20rpx; background: #fff; border: 1rpx solid #e6e6e6; border-radius: 22rpx; box-shadow: 0 8rpx 20rpx rgba(0,0,0,.08); display: flex; flex-wrap: wrap; gap: 16rpx; }.bus-rail { position: absolute; left: -32rpx; top: 0; bottom: 0; border-left: 6rpx solid #1451aa; }.bus-card .bus-image { width: 180rpx; height: 130rpx; }.bus-details { flex: 1; min-width: 330rpx; padding-top: 4rpx; }.bus-info { display: flex; justify-content: space-between; gap: 18rpx; margin: 8rpx 0; }.bus-label { color: #9b9b9b; font-size: 23rpx; }.bus-value { font-size: 25rpx; font-weight: 800; text-align: right; }.bus-value.blue { color: #1474c9; }.bus-card .navigate-stop { margin-left: 0; font-size: 22rpx; }.intermediate-toggle { width: 100%; padding: 18rpx 20rpx; background: #f5f5f5; border-radius: 34rpx; font-size: 23rpx; }.intermediate-toggle text { float: right; font-size: 32rpx; }.walk-after { min-height: 88rpx; }.destination-point { margin-top: 4rpx; }
