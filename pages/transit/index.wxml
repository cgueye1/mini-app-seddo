<view class="page">
  <view class="header">
    <view class="back" bindtap="handleBack">‹</view>
    <view>
      <view class="eyebrow">SEDDo MOBILITY</view>
      <view class="title">Où allons-nous ?</view>
    </view>
  </view>

  <view class="search-panel">
    <view class="field-row">
      <view class="dot origin-dot"></view>
      <input class="field-input" value="{{originText}}" data-field="origin" bindinput="handleInput" placeholder="Origine" />
      <view class="locate" bindtap="handleUseLocation">◎</view>
    </view>
    <view wx:if="{{originSuggestions.length}}" class="suggestions">
      <view wx:for="{{originSuggestions}}" wx:key="placeId" class="suggestion" data-field="origin" data-index="{{index}}" bindtap="handleSelectPlace">
        <image class="pin" src="/assets/transit/arretbus.png" mode="aspectFit" /><view><view class="suggestion-name">{{item.name}}</view><view class="suggestion-address">{{item.address}}</view></view>
      </view>
    </view>
    <view class="connector"></view>
    <view class="field-row">
      <view class="dot destination-dot"></view>
      <input class="field-input" value="{{destinationText}}" data-field="destination" bindinput="handleInput" placeholder="Destination" />
    </view>
    <view wx:if="{{destinationSuggestions.length}}" class="suggestions">
      <view wx:for="{{destinationSuggestions}}" wx:key="placeId" class="suggestion" data-field="destination" data-index="{{index}}" bindtap="handleSelectPlace">
        <image class="pin" src="/assets/transit/arretbus.png" mode="aspectFit" /><view><view class="suggestion-name">{{item.name}}</view><view class="suggestion-address">{{item.address}}</view></view>
      </view>
    </view>
    <image class="swap" src="/assets/transit/switch.svg" mode="aspectFit" bindtap="handleSwap" />
  </view>

  <view class="tools">
    <picker mode="date" value="{{date}}" bindchange="handleDateChange"><view class="tool">◷ <text>{{date}}</text></view></picker>
    <picker mode="time" value="{{time}}" bindchange="handleTimeChange"><view class="tool">◴ <text>{{time}}</text></view></picker>
    <button class="search-button" bindtap="handleSearch">Rechercher</button>
  </view>

  <view wx:if="{{!routes.length}}" class="favorites-title">Favoris</view>
  <view wx:if="{{!routes.length}}" class="favorites">
    <view wx:for="{{favoriteItems}}" wx:key="key" class="favorite" data-key="{{item.key}}" bindtap="handleFavoriteSelect">
      <image class="favorite-icon" src="{{item.icon}}" mode="aspectFit" />
      <view class="favorite-label">{{item.label}}</view>
      <view class="favorite-place">{{favorites[item.key].name || 'Ajouter une adresse'}}</view>
      <button class="save-button" catchtap="handleSaveFavorite" data-key="{{item.key}}"><image src="{{item.actionIcon}}" mode="aspectFit" /></button>
    </view>
  </view>

  <view wx:if="{{loading}}" class="state loading-state"><view class="loader"></view><text>Recherche des lignes...</text></view>
  <view wx:if="{{error}}" class="state error-state">{{error}}</view>

  <view wx:if="{{routes.length}}" class="results">
    <scroll-view class="route-tabs" scroll-x="true" enhanced="true" show-scrollbar="false">
      <view wx:for="{{routes}}" wx:key="summary" class="route-tab {{index === selectedRouteIndex ? 'route-tab-active' : ''}}" data-index="{{index}}" bindtap="handleSelectRoute">
        <view class="tab-title">{{index === 0 ? '🚀 Plus rapide' : index === 1 ? '🔄 Alternative' : '🗺️ Panoramique'}}</view>
        <view class="tab-duration">{{item.duration}}</view>
      </view>
    </scroll-view>

    <view class="timeline-route">
      <view class="route-badges">
        <view class="direct-badge {{routes[selectedRouteIndex].direct ? 'direct' : 'transfer'}}">{{routes[selectedRouteIndex].direct ? '✓ Direct' : '↔ Correspondance'}}</view>
        <view class="time-badge">◷ {{routes[selectedRouteIndex].duration}}</view>
      </view>

      <view class="timeline-point origin-point"><view class="point-ring"></view><view class="point-label">{{originText}}</view></view>
      <view wx:for="{{routes[selectedRouteIndex].legs}}" wx:for-item="leg" wx:key="line" class="timeline-leg">
        <view class="walk-segment"><view class="walk-line"></view><view class="walk-icon">♟</view><view>{{leg.walkTo}} <text wx:if="{{leg.walkToMinutes}}">| {{leg.walkToMinutes}} min</text></view></view>
        <view class="stop-row"><image src="/assets/transit/arretbus.png" mode="aspectFit" /><view>{{leg.from}}</view></view>
        <view class="bus-card">
          <view class="bus-rail"></view><image class="bus-image" src="{{leg.busImage}}" mode="aspectFit" />
          <view class="bus-details"><view class="bus-info"><text class="bus-label">Ligne de bus :</text><text class="bus-value">{{leg.line}}</text></view><view class="bus-info"><text class="bus-label">Heure de départ :</text><text class="bus-value">{{leg.departure}}</text></view><view wx:if="{{leg.trafficDuration}}" class="bus-info"><text class="bus-label">Durée trajet :</text><text class="bus-value blue">{{leg.trafficDuration}}</text></view></view>
          <view class="navigate-stop" data-lat="{{leg.startLat}}" data-lon="{{leg.startLon}}" data-name="{{leg.from}}" catchtap="handleNavigateToStop">⌃ Naviguer vers cet arrêt</view>
          <view wx:if="{{leg.intermediateStops.length}}" class="intermediate-toggle">({{leg.intermediateStops.length}}) Arrêts intermédiaires <text>⌄</text></view>
        </view>
        <view class="stop-row"><image src="/assets/transit/arretbus.png" mode="aspectFit" /><view>{{leg.to}}</view></view>
        <view class="walk-segment walk-after"><view class="walk-line"></view><view class="walk-icon">♟</view><view>{{leg.walkFrom}} <text wx:if="{{leg.walkFromMinutes}}">| {{leg.walkFromMinutes}} min</text></view></view>
      </view>
      <view class="timeline-point destination-point"><view class="point-pin">♥</view><view class="point-label">{{destinationText}}</view></view>
    </view>
  </view>
</view>
